<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard - FEPODRA</title>
    <!-- HTML5 QR Code Scanner CDN -->
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <style>
        :root {
            --primary-green: #006633;
            --dark-green: #004d26;
            --accent-gold: #ffc107;
            --light-bg: #f8f9fa;
            --card-bg: rgba(255, 255, 255, 0.96);
            --text-color: #333333;
        }
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            /* Hoton bango mai kamannin jami'a da dark green gradient overlay */
            background: linear-gradient(rgba(0, 51, 26, 0.8), rgba(0, 51, 26, 0.85)), 
                        url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=1920&q=80') no-repeat center center fixed;
            background-size: cover;
            margin: 0; 
            padding: 0; 
            color: var(--text-color); 
            min-height: 100vh;
        }
        .navbar { 
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            color: var(--primary-green); 
            padding: 18px 40px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            border-bottom: 1px solid rgba(0,102,51,0.1);
            flex-wrap: wrap;
            gap: 15px;
        }
        .navbar h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
        }
        .user-info-area {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 14px;
            font-weight: 600;
            color: #444;
        }
        .logout { 
            color: white; 
            text-decoration: none; 
            background: #dc3545; 
            padding: 8px 18px; 
            border-radius: 8px; 
            font-size: 14px; 
            font-weight: 600;
            transition: 0.3s;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);
        }
        .logout:hover { 
            background: #b02a37; 
            transform: translateY(-1px);
        }
        
        .container { 
            max-width: 900px; 
            margin: 40px auto; 
            padding: 0 20px 40px 20px; 
        }
        .card { 
            background: var(--card-bg); 
            backdrop-filter: blur(10px);
            padding: 35px; 
            border-radius: 16px; 
            box-shadow: 0 20px 40px rgba(0,0,0,0.3); 
            margin-bottom: 30px; 
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-top: 6px solid var(--primary-green); 
        }
        .card h3 { 
            color: var(--dark-green); 
            margin-top: 0; 
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 10px;
        }
        .card p {
            color: #666;
            font-size: 14px;
            margin-bottom: 20px;
            line-height: 1.5;
        }
        
        /* Scanner styling */
        #reader { 
            width: 100%; 
            max-width: 420px; 
            margin: 0 auto; 
            border-radius: 10px; 
            overflow: hidden; 
            border: 2px solid #eaeaea;
            background: #fff;
        }
        #reader video {
            border-radius: 10px;
        }
        
        /* Table styling */
        .table-responsive {
            overflow-x: auto;
        }
        table { 
            width: 100%; 
            border-collapse: collapse; 
            margin-top: 15px; 
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 0 1px #eaeaea;
        }
        th, td { 
            padding: 15px 20px; 
            border-bottom: 1px solid #eee; 
            text-align: left; 
            font-size: 14px; 
        }
        th { 
            background: #f1f5f9; 
            color: var(--dark-green); 
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        td {
            color: #444;
        }
        tr:last-child td {
            border-bottom: none;
        }
        tr:hover td {
            background: #fafafa;
        }
        .badge-active {
            background: #d4edda;
            color: #155724;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 13px;
        }
        .empty-text {
            text-align: center; 
            color: #666; 
            padding: 30px !important;
            font-style: italic;
        }

        @media (max-width: 768px) {
            .navbar { padding: 15px 20px; }
            .card { padding: 25px 20px; }
        }
    </style>
</head>
<body>

    <div class="navbar">
        <h2>FEPODRA Student Portal</h2>
        <div class="user-info-area">
            <span>👤 <%= user.fullname %> (<%= user.portal_id %>)</span>
            <a href="/login" class="logout">Logout</a>
        </div>
    </div>

    <div class="container">

        <!-- 1. QR Scanner Card -->
        <div class="card">
            <h3>Scan Attendance QR Code</h3>
            <p>Point your camera clearly at the lecturer's active QR code session to record your presence instantly.</p>
            <div id="reader"></div>
        </div>

        <!-- 2. My Attendance Summary Card -->
        <div class="card">
            <h3>My Attendance Record</h3>
            <p>Overview of your accumulated presence across enrolled courses.</p>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Course Code</th>
                            <th>Total Times Present</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (attendanceSummary.length === 0) { %>
                            <tr><td colspan="3" class="empty-text">No attendance records found yet.</td></tr>
                        <% } else { %>
                            <% attendanceSummary.forEach(record => { %>
                                <tr>
                                    <td><strong><%= record.course_code %></strong></td>
                                    <td><%= record.total_present %> Times</td>
                                    <td><span class="badge-active">Active</span></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script>
        // Function called when QR code is successfully scanned
        function onScanSuccess(decodedText, decodedResult) {
            console.log(`Code matched = ${decodedText}`);
            // Automatically redirect the student browser to the check-in verification page
            window.location.href = decodedText + "&student_id=<%= user.portal_id %>";
        }

        function onScanFailure(error) {
            // handle scan failure silently to keep the scanner running smoothly
        }

        let html5QrcodeScanner = new Html5QrcodeScanner(
            "reader", { fps: 10, qrbox: { width: 250, height: 250 } }, false);
        html5QrcodeScanner.render(onScanSuccess, onScanFailure);
    </script>

</body>
</html>