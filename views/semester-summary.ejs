<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Semester Attendance Summary - FEPODRA</title>
    <style>
        :root {
            --primary-green: #006633;
            --dark-green: #004d26;
            --accent-gold: #ffc107;
            --light-bg: #f8f9fa;
            --card-bg: rgba(255, 255, 255, 0.96);
            --text-color: #333333;
        }
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            /* Hoton bango mai kamannin jami'a da dark green gradient overlay */
            background: linear-gradient(rgba(0, 51, 26, 0.8), rgba(0, 51, 26, 0.85)), 
                        url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=1920&q=80') no-repeat center center fixed;
            background-size: cover;
            margin: 0; 
            padding: 0; 
            color: var(--text-color); 
            min-height: 100vh;
        }
        .navbar { 
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            color: var(--primary-green); 
            padding: 18px 40px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            box-shadow: 0 4px 20px rgba(0,0,0,0.1); 
            border-bottom: 1px solid rgba(0,102,51,0.1);
        }
        .navbar h2 { 
            margin: 0; 
            font-size: 20px; 
            font-weight: 700;
        }
        .back-btn { 
            color: white; 
            text-decoration: none; 
            background: var(--primary-green); 
            padding: 9px 18px; 
            border-radius: 8px; 
            font-size: 14px; 
            font-weight: 600;
            transition: 0.3s; 
            box-shadow: 0 4px 12px rgba(0,102,51,0.2);
        }
        .back-btn:hover { 
            background: var(--dark-green); 
            transform: translateY(-1px);
        }

        .container { 
            max-width: 1000px; 
            margin: 40px auto; 
            background: var(--card-bg); 
            backdrop-filter: blur(10px);
            padding: 40px; 
            border-radius: 16px; 
            box-shadow: 0 20px 40px rgba(0,0,0,0.3); 
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-top: 6px solid var(--primary-green); 
        }
        .header-flex {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 25px;
            border-bottom: 1px solid #eaeaea;
            padding-bottom: 20px;
        }
        h3 { 
            color: var(--dark-green); 
            margin: 0; 
            font-size: 24px;
            font-weight: 800;
        }
        .sessions-badge {
            background: rgba(0, 102, 51, 0.1);
            color: var(--primary-green);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }
        
        .print-btn { 
            background: var(--accent-gold); 
            color: #111; 
            border: none; 
            padding: 12px 24px; 
            border-radius: 8px; 
            cursor: pointer; 
            font-size: 15px; 
            margin-bottom: 25px; 
            font-weight: 700; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .print-btn:hover { 
            background: #e0a800; 
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        }

        .table-responsive {
            overflow-x: auto;
        }
        table { 
            width: 100%; 
            border-collapse: collapse; 
            margin-top: 10px; 
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 0 1px #eaeaea;
        }
        th, td { 
            padding: 15px 20px; 
            text-align: left; 
            border-bottom: 1px solid #eee; 
        }
        th { 
            background: #f1f5f9; 
            color: var(--dark-green); 
            font-weight: 700;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        td {
            font-size: 15px;
            color: #444;
        }
        tr:last-child td {
            border-bottom: none;
        }
        tr:hover td {
            background: #fafafa;
        }
        
        .badge-present { 
            background: #d4edda; 
            color: #155724; 
            padding: 6px 12px; 
            border-radius: 6px; 
            font-weight: 700; 
            font-size: 13px;
        }
        .badge-absent { 
            background: #f8d7da; 
            color: #721c24; 
            padding: 6px 12px; 
            border-radius: 6px; 
            font-weight: 700; 
            font-size: 13px;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #666;
            font-size: 15px;
        }

        @media print {
            .navbar, .print-btn, .back-btn { display: none; }
            body { background: white; }
            .container { box-shadow: none; border: none; margin: 0; padding: 20px; max-width: 100%; background: white; }
            table { box-shadow: none; border: 1px solid #ddd; }
        }

        @media (max-width: 768px) {
            .container { margin: 20px 15px; padding: 20px; }
            .navbar { padding: 15px 20px; }
        }
    </style>
</head>
<body>

    <div class="navbar">
        <h2>FEPODRA Attendance Portal</h2>
        <a href="/lecturer/dashboard" class="back-btn">← Back to Dashboard</a>
    </div>

    <div class="container">
        <div class="header-flex">
            <div>
                <h3>Cumulative Semester Summary</h3>
            </div>
            <div class="sessions-badge">
                Total Sessions: <strong><%= totalSessions %></strong>
            </div>
        </div>
        
        <button class="print-btn" onclick="window.print()">🖨️ Print / Export Summary</button>

        <% if (studentSummary && studentSummary.length > 0) { %>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Portal ID / Reg Number</th>
                            <th>Student Full Name</th>
                            <th>Total Present</th>
                            <th>Total Absent</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% studentSummary.forEach(item => { %>
                            <tr>
                                <td><strong><%= item.portal_id %></strong></td>
                                <td><%= item.fullname %></td>
                                <td><span class="badge-present"><%= item.present %></span></td>
                                <td><span class="badge-absent"><%= item.absent %></span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty-state">
                <p>No students or sessions found for this lecturer yet.</p>
            </div>
        <% } %>
    </div>

</body>
</html>