<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance Report - FEPODRA</title>
    <style>
        :root {
            --primary-green: #006633;
            --dark-green: #004d26;
            --accent-gold: #ffc107;
            --light-bg: #f8f9fa;
            --card-bg: rgba(255, 255, 255, 0.96);
            --text-color: #333333;
        }
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            /* Hoton bango mai kamannin jami'a da dark green gradient overlay */
            background: linear-gradient(rgba(0, 51, 26, 0.8), rgba(0, 51, 26, 0.85)), 
                        url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=1920&q=80') no-repeat center center fixed;
            background-size: cover;
            margin: 0; 
            padding: 40px 20px; 
            color: var(--text-color); 
            min-height: 100vh;
        }
        .container { 
            max-width: 900px; 
            margin: 0 auto; 
            background: var(--card-bg); 
            backdrop-filter: blur(10px);
            padding: 40px; 
            border-radius: 16px; 
            box-shadow: 0 20px 40px rgba(0,0,0,0.3); 
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-top: 6px solid var(--primary-green); 
        }
        
        .header-flex {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 25px;
            border-bottom: 1px solid #eaeaea;
            padding-bottom: 20px;
        }
        h2 { 
            color: var(--dark-green); 
            margin: 0 0 10px 0; 
            font-size: 26px;
            font-weight: 800;
        }
        .meta-info {
            font-size: 14px;
            color: #555;
            line-height: 1.6;
        }
        .meta-info strong {
            color: var(--primary-green);
        }
        
        .badge-total {
            background: rgba(0, 102, 51, 0.1);
            color: var(--primary-green);
            padding: 10px 20px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 700;
        }

        .action-bar {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }
        .print-btn { 
            background: var(--accent-gold); 
            color: #111; 
            border: none; 
            padding: 12px 22px; 
            border-radius: 8px; 
            cursor: pointer; 
            font-size: 14px; 
            font-weight: 700; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .print-btn:hover { 
            background: #e0a800; 
            transform: translateY(-2px);
        }

        .table-responsive {
            overflow-x: auto;
        }
        table { 
            width: 100%; 
            border-collapse: collapse; 
            margin-top: 10px; 
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 0 1px #eaeaea;
        }
        th, td { 
            padding: 15px 20px; 
            text-align: left; 
            border-bottom: 1px solid #eee; 
            font-size: 14px;
        }
        th { 
            background: #f1f5f9; 
            color: var(--dark-green); 
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        td {
            color: #444;
        }
        tr:last-child td {
            border-bottom: none;
        }
        tr:hover td {
            background: #fafafa;
        }
        
        .badge-present {
            background: #d4edda;
            color: #155724;
            padding: 5px 10px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 12px;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #666;
            font-style: italic;
        }

        .back-btn { 
            display: inline-block; 
            margin-top: 30px; 
            text-decoration: none; 
            background: #6c757d; 
            color: white; 
            padding: 12px 22px; 
            border-radius: 8px; 
            font-weight: 600;
            font-size: 14px;
            transition: 0.3s;
        }
        .back-btn:hover { 
            background: #5a6268; 
            transform: translateY(-1px);
        }

        @media print {
            body { background: white; padding: 0; }
            .container { box-shadow: none; border: none; margin: 0; padding: 20px; max-width: 100%; background: white; }
            .print-btn, .back-btn { display: none; }
            table { box-shadow: none; border: 1px solid #ddd; }
        }

        @media (max-width: 768px) {
            .container { padding: 20px; }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="header-flex">
            <div>
                <h2>Attendance Report</h2>
                <div class="meta-info">
                    <p style="margin: 0 0 5px 0;">Course: <strong><%= session.course_code %></strong></p>
                    <p style="margin: 0;">Session ID: <strong>#<%= session.id %></strong> | Created Date: <strong><%= new Date(session.created_at).toLocaleString('en-GB', { timeZone: 'Africa/Lagos' }) %></strong></p>
                </div>
            </div>
            <div class="badge-total">
                Total Present: <strong><%= logs.length %></strong>
            </div>
        </div>

        <div class="action-bar">
            <button class="print-btn" onclick="window.print()">🖨️ Print / Export Report</button>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th>Portal ID (Reg No)</th>
                        <th>Student Name</th>
                        <th>Time Scanned (WAT)</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (logs.length === 0) { %>
                        <tr><td colspan="4" class="empty-state">No attendance recorded yet for this session.</td></tr>
                    <% } else { %>
                        <% logs.forEach((log, index) => { %>
                            <tr>
                                <td><strong><%= index + 1 %></strong></td>
                                <td><strong><%= log.portal_id %></strong></td>
                                <td><%= log.fullname %></td>
                                <td><span class="badge-present"><%= log.scanned_at ? new Date(log.scanned_at).toLocaleString('en-GB', { timeZone: 'Africa/Lagos' }) : 'N/A' %></span></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <a href="/lecturer/dashboard" class="back-btn">← Back to Dashboard</a>
    </div>

</body>
</html>