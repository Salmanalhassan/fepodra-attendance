<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - FEPODRA Attendance</title>
    <style>
        :root {
            --primary-green: #006633;
            --dark-green: #004d26;
            --accent-gold: #ffc107;
            --light-bg: #f8f9fa;
            --card-bg: rgba(255, 255, 255, 0.96);
            --text-color: #333333;
        }
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: linear-gradient(rgba(0, 51, 26, 0.8), rgba(0, 51, 26, 0.85)), 
                        url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=1920&q=80') no-repeat center center fixed;
            background-size: cover;
            margin: 0; 
            padding: 0; 
            color: var(--text-color); 
            min-height: 100vh;
        }
        .navbar { 
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            color: var(--primary-green); 
            padding: 18px 40px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            border-bottom: 1px solid rgba(0,102,51,0.1);
            flex-wrap: wrap;
            gap: 15px;
        }
        .navbar h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
        }
        .admin-info {
            display: flex;
            align-items: center;
            gap: 15px;
            font-weight: 600;
            font-size: 14px;
            color: #444;
        }
        .logout { 
            color: white; 
            text-decoration: none; 
            background: #dc3545; 
            padding: 8px 18px; 
            border-radius: 8px; 
            font-size: 14px; 
            font-weight: 600;
            transition: 0.3s;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);
        }
        .logout:hover { 
            background: #b02a37; 
            transform: translateY(-1px);
        }
        
        .container { 
            max-width: 1000px; 
            margin: 40px auto; 
            padding: 0 20px 40px 20px; 
        }
        .card { 
            background: var(--card-bg); 
            backdrop-filter: blur(10px);
            padding: 35px; 
            border-radius: 16px; 
            box-shadow: 0 20px 40px rgba(0,0,0,0.3); 
            margin-bottom: 30px; 
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-top: 6px solid var(--primary-green); 
        }
        .card h3 { 
            color: var(--dark-green); 
            margin-top: 0; 
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 8px;
        }
        .card-desc {
            color: #666;
            font-size: 14px;
            margin-bottom: 25px;
        }
        
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        .form-group { 
            margin-bottom: 20px; 
        }
        .form-group.full-width {
            grid-column: span 2;
        }
        label { 
            display: block; 
            margin-bottom: 8px; 
            font-weight: 600; 
            color: #444;
            font-size: 14px;
        }
        input, select { 
            width: 100%; 
            padding: 12px 14px; 
            border: 1px solid #ddd; 
            border-radius: 8px; 
            box-sizing: border-box; 
            font-size: 14px;
            outline: none;
            transition: border-color 0.3s, box-shadow 0.3s;
            background: #fff;
        }
        input:focus, select:focus {
            border-color: var(--primary-green);
            box-shadow: 0 0 0 3px rgba(0, 102, 51, 0.15);
        }
        
        .btn-submit { 
            padding: 14px 28px; 
            background: var(--primary-green); 
            color: white; 
            border: none; 
            border-radius: 8px; 
            font-weight: 700; 
            font-size: 15px;
            cursor: pointer; 
            transition: 0.3s;
            box-shadow: 0 4px 12px rgba(0, 102, 51, 0.2);
        }
        .btn-submit:hover { 
            background: var(--dark-green); 
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0, 102, 51, 0.3);
        }

        .table-responsive {
            overflow-x: auto;
        }
        table { 
            width: 100%; 
            border-collapse: collapse; 
            margin-top: 15px; 
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 0 1px #eaeaea;
        }
        th, td { 
            padding: 15px 20px; 
            border-bottom: 1px solid #eee; 
            text-align: left; 
            font-size: 14px; 
        }
        th { 
            background: #f1f5f9; 
            color: var(--dark-green); 
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        td {
            color: #444;
        }
        tr:last-child td {
            border-bottom: none;
        }
        tr:hover td {
            background: #fafafa;
        }
        
        .success-box { 
            background: #d4edda; 
            color: #155724; 
            padding: 15px; 
            border-radius: 8px; 
            border: 1px solid #c3e6cb; 
            margin-bottom: 25px; 
            font-weight: 600;
            font-size: 14px;
        }
        .role-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
        }
        .role-admin { background: #fee2e2; color: #991b1b; }
        .role-lecturer { background: #fef3c7; color: #92400e; }
        .role-student { background: #dcfce7; color: #166534; }

        .action-btns {
            display: flex;
            gap: 8px;
        }
        .btn-edit {
            background: #ffc107;
            color: #111;
            padding: 6px 12px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 700;
            transition: 0.2s;
        }
        .btn-edit:hover {
            background: #e0a800;
        }
        .btn-delete {
            background: #dc3545;
            color: white;
            padding: 6px 12px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 12px;
            font-weight: 700;
            transition: 0.2s;
        }
        .btn-delete:hover {
            background: #b02a37;
        }

        @media (max-width: 768px) {
            .form-grid { grid-template-columns: 1fr; }
            .form-group.full-width { grid-column: span 1; }
            .navbar { padding: 15px 20px; }
            .card { padding: 25px 20px; }
        }
    </style>
</head>
<body>

    <div class="navbar">
        <h2>FEPODRA Admin Portal</h2>
        <div class="admin-info">
            <span>🛡️ Welcome, Admin</span>
            <a href="/login" class="logout">Logout</a>
        </div>
    </div>

    <div class="container">

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="success-box">✓ <%= success %></div>
        <% } %>

        <!-- Register New User Card -->
        <div class="card">
            <h3>Register New System User</h3>
            <p class="card-desc">Create secure accounts for students, lecturers, or administrative staff.</p>
            
            <form action="/admin/register-user" method="POST">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Portal ID / Staff ID</label>
                        <input type="text" name="portal_id" placeholder="e.g., ND/COM/24/0002 or LEC/COM/002" required>
                    </div>
                    
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" name="fullname" placeholder="Enter full name" required>
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" name="password" placeholder="Create account password" required>
                    </div>

                    <div class="form-group">
                        <label>User Role</label>
                        <select name="role">
                            <option value="student">Student</option>
                            <option value="lecturer">Lecturer</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn-submit">Add New User →</button>
            </form>
        </div>

        <!-- All Users List Card -->
        <div class="card">
            <h3>Registered Users Directory</h3>
            <p class="card-desc">Comprehensive list of all active profiles registered within the institution with management controls.</p>
            
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>ID / Reg No</th>
                            <th>Full Name</th>
                            <th>Role</th>
                            <th>Created Date (WAT)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(u => { %>
                            <tr>
                                <td><strong><%= u.portal_id %></strong></td>
                                <td><%= u.fullname %></td>
                                <td>
                                    <span class="role-badge role-<%= u.role %>">
                                        <%= u.role.toUpperCase() %>
                                    </span>
                                </td>
                                <td>
                                    <%= new Date(u.created_at).toLocaleString('en-GB', { timeZone: 'Africa/Lagos' }) %>
                                </td>
                                <td>
                                    <div class="action-btns">
                                        <!-- An gyara 'user.portal_id' zuwa 'u.portal_id' anan -->
                                        <a href="/admin/edit-user?id=<%= u.portal_id %>" class="btn-edit">Edit</a>
                                        
                                        <form action="/admin/delete-user" method="POST" style="display:inline;">
                                            <!-- An gyara 'user.portal_id' zuwa 'u.portal_id' anan ma -->
                                            <input type="hidden" name="portal_id" value="<%= u.portal_id %>">
                                            <button type="submit" onclick="return confirm('DO YOU WANT Delete USER?')" class="btn-delete">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</body>
</html>